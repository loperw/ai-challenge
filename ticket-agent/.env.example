# Use ticket-agent/.env or add these settings to the existing repository-root .env.
# Both .env files are gitignored. Keep existing keys; do not overwrite a configured file.
# Process environment takes priority, then ticket-agent/.env, then repository-root .env.
# Used for one-off AI search and summaries when monitoring results change.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
# Optional for one-off search; required for Telegram notifications and monitoring.
# An empty app-local value also overrides a value in the repository-root .env.
TELEGRAM_BOT_TOKEN=

# Defaults to the public pass.rw.by route HTML. Set only if using a permitted custom provider.
RAILWAY_BASE_URL=https://pass.rw.by
# Optional JSON endpoint override; when set, the HTML adapter is bypassed.
RAILWAY_SEARCH_URL=
# Optional bearer credential for a custom JSON provider.
RAILWAY_API_TOKEN=
TICKET_AGENT_PORT=3035
# Public address of this app for opening Telegram links from a phone or another computer.
# If omitted, ticket selection links point to http://127.0.0.1:3035 on this computer.
TICKET_AGENT_PUBLIC_URL=
