[Unit]
Description=Private chat agent
After=network-online.target ollama.service chat-agent-network.service
Requires=chat-agent-network.service
Wants=network-online.target

[Service]
User=chat-agent
Group=chat-agent
WorkingDirectory=/opt/chat-agent
EnvironmentFile=/etc/chat-agent.env
ExecStart=/usr/local/bin/node /opt/chat-agent/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chat-agent/data
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
