# Copy this file to .env and fill in the keys for the providers you want to use.
# Local Qwen via Ollama needs no API keys or .env file.
DEEPSEEK_API_KEY=replace-with-your-key
OPENROUTER_API_KEY=replace-with-your-key
GEMINI_API_KEY=replace-with-your-key
# Optional system instruction applied by every chat agent.
AGENT_SYSTEM_PROMPT=
# Optional absolute path to a JSON MCP registry (default: mcp/servers.json).
MCP_SERVERS_FILE=
